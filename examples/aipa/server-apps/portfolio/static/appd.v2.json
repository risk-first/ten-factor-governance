{
  "applications": [
    {
      "appId": "aipa-portfolio",
      "name": "AIPA Portfolio",
      "title": "AIPA Portfolio",
      "description": "Displays portfolios and holdings; serves GetPortfolio and ViewHoldings; broadcasts fdc3.portfolio contexts.",
      "categories": ["AIPA", "Portfolio"],
      "icons": [{ "src": "http://localhost:4100/icon.svg" }],
      "type": "web",
      "details": { "url": "http://localhost:4100/" },
      "interop": {
        "intents": {
          "listensFor": {
            "GetPortfolio": {
              "displayName": "Get Portfolio",
              "purpose": "Retrieve the current portfolio holdings as an fdc3.portfolio context.",
              "contexts": ["fdc3.portfolio"]
            },
            "ViewHoldings": {
              "displayName": "View Holdings",
              "purpose": "Show portfolio holdings related to a selected instrument.",
              "contexts": ["fdc3.instrument"]
            }
          },
          "raises": {}
        },
        "userChannels": {
          "broadcasts": ["fdc3.instrument", "fdc3.portfolio"],
          "listensFor": []
        },
        "appChannels": []
      },
      "hostManifests": {
        "sail": { "injectApi": "2.0" }
      }
    }
  ],
  "message": "OK"
}
