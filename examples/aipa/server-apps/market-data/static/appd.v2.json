{
  "applications": [
    {
      "appId": "aipa-market-data",
      "name": "AIPA Market Data",
      "title": "AIPA Market Data",
      "description": "Quotes and charts for ViewChart; GetPriceHistory for peer apps; fdc3.data data app (advertiseDatasets / GetAppData / ViewData with tabularData); proxies Finnhub and yahoo-finance2.",
      "categories": ["AIPA", "Market Data"],
      "icons": [{ "src": "http://localhost:4103/icon.svg" }],
      "type": "web",
      "details": { "url": "http://localhost:4103/" },
      "interop": {
        "intents": {
          "listensFor": {
            "ViewChart": {
              "displayName": "View Chart",
              "contexts": ["fdc3.instrument"]
            },
            "demo.GetPriceHistory": {
              "displayName": "Get Price History",
              "contexts": [
                "fdc3.instrument",
                "fdc3.instrumentList",
                "fdc3.portfolio",
                "fdc3.chart"
              ]
            },
            "GetAppData": {
              "displayName": "Get App Data",
              "contexts": ["fdc3.data.dataRequest"]
            },
            "ViewData": {
              "displayName": "View Data",
              "contexts": ["fdc3.data.tabularData"]
            }
          }
        }
      },
      "hostManifests": {
        "sail": { "injectApi": "2.0" }
      }
    }
  ],
  "message": "OK"
}
