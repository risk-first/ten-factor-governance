# Optional data sources — apps fall back to fixtures when unset
# aipa-market-data, aipa-research
FINNHUB_API_KEY=
# aipa-risk
FRED_API_KEY=
# aipa-research
SEC_USER_AGENT="AIPA-Demo your-email@example.com"

# aipa-agent-harness LLM (OpenBB agent-rita compatible). Set at least one provider.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1   # optional LM Studio / compatible
# LM_STUDIO_MODEL=gpt-4o-mini                # fallback when DEFAULT_MODEL is empty / not openai:…
OPENROUTER_API_KEY=
GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/api
DEFAULT_MODEL=openai:gpt-4o-mini

# Published Gemara catalogs used in Sail Governance receipts / Console links
# (apa-ctl-005-propose-human-approval and apa-ctl-005-propose-human-approval.ar01).
GEMARA_CONTROLS_CATALOG_URL=https://tenfactorgovernance.org/docs/artifacts/finos/ai-portfolio-assistant/gemara/components/ai-portfolio-assistant/controls-catalog
# GEMARA_POLICY_URL=https://tenfactorgovernance.org/docs/artifacts/finos/ai-portfolio-assistant/gemara/policy

# aipa-jev-governance — engine is started separately; CLEF_* belong on that process
# JEV_ENGINE_URL=http://localhost:3000
# ENGINE_API_KEY=
