{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "main.ts",
    "common/**/*.ts",
    "common/**/*.tsx",
    "server-apps/**/*.ts",
    "server-apps/**/*.tsx",
    "front-end-apps/**/*.ts",
    "front-end-apps/**/*.tsx",
    "directory/**/*.ts",
    "directory/**/*.tsx"
  ],
  "exclude": [
    "server-apps/**/vendor/**",
    "server-apps/**/.vite/**",
    "front-end-apps/**/.vite/**"
  ]
}
