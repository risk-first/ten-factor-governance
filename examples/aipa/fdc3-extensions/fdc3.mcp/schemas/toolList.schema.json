{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/mcp.toolList.schema.json",
  "type": "object",
  "title": "MCP Tool List",
  "description": "IntentResult of `ListMcpTools`. Tool catalog for the LLM registry: name, description, JSON Schema `inputSchema`, and owning `serverId`.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "fdc3.mcp.toolList"
        },
        "tools": {
          "type": "array",
          "title": "Tools",
          "items": {
            "type": "object",
            "properties": {
              "serverId": {
                "type": "string",
                "title": "Server ID"
              },
              "name": {
                "type": "string",
                "title": "Tool name"
              },
              "description": {
                "type": "string",
                "title": "Description"
              },
              "inputSchema": {
                "type": "object",
                "title": "Input schema",
                "description": "JSON Schema for tool arguments (MCP tools/list shape).",
                "additionalProperties": true
              }
            },
            "required": ["serverId", "name"]
          }
        }
      },
      "required": ["type", "tools"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ],
  "examples": [
    {
      "type": "fdc3.mcp.toolList",
      "tools": [
        {
          "serverId": "rita-mcp",
          "name": "web_search",
          "description": "Search the web",
          "inputSchema": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"]
          }
        }
      ]
    }
  ]
}
