{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/discoverability.appDirectory.schema.json",
  "type": "object",
  "title": "App Directory",
  "description": "Reply to `fdc3.discoverability.discoverApps` on app channel `fdc3.discoverability`. Carries a set of FDC3 App Directory `Application` records the caller may open or raise intents against. Each item conforms to the published App Directory OpenAPI `Application` schema.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "fdc3.discoverability.appDirectory"
        },
        "apps": {
          "type": "array",
          "title": "Apps",
          "description": "App Directory Application records ([FDC3 AppD `Application`](https://fdc3.finos.org/schemas/next/appd.schema.json#/components/schemas/Application)).",
          "items": {
            "$ref": "https://fdc3.finos.org/schemas/next/appd.schema.json#/components/schemas/Application"
          }
        }
      },
      "required": ["type", "apps"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ],
  "examples": [
    {
      "type": "fdc3.discoverability.appDirectory",
      "apps": [
        {
          "appId": "aipa.agent-harness",
          "title": "Agent Harness",
          "description": "LLM loop and FDC3 tool planning",
          "type": "web",
          "details": { "url": "http://localhost:4107/" }
        },
        {
          "appId": "aipa.markdown-viewer",
          "title": "Markdown Viewer",
          "type": "web",
          "details": { "url": "http://localhost:4108/" }
        }
      ]
    }
  ]
}
