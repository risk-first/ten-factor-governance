{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/discoverability.appDirectory.schema.json",
  "type": "object",
  "title": "App Directory",
  "description": "Reply to `fdc3.discoverability.discoverApps` on app channel `fdc3.discoverability`. Carries a slim catalog of available apps (appId, title, description) the caller may open or raise intents against.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "fdc3.discoverability.appDirectory"
        },
        "apps": {
          "type": "array",
          "title": "Apps",
          "description": "Slim app catalog entries derived from App Directory records.",
          "items": {
            "type": "object",
            "properties": {
              "appId": {
                "type": "string",
                "title": "App id",
                "description": "FDC3 App Directory `appId`."
              },
              "title": {
                "type": "string",
                "title": "Title",
                "description": "Optional user-visible app title."
              },
              "description": {
                "type": "string",
                "title": "Description",
                "description": "Optional short description of the app."
              }
            },
            "required": ["appId"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "apps"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ],
  "examples": [
    {
      "type": "fdc3.discoverability.appDirectory",
      "apps": [
        {
          "appId": "aipa.agent-harness",
          "title": "Agent Harness",
          "description": "LLM loop and FDC3 tool planning"
        },
        {
          "appId": "aipa.markdown-viewer",
          "title": "Markdown Viewer",
          "description": "Renders fdc3.data.markdown"
        }
      ]
    }
  ]
}
