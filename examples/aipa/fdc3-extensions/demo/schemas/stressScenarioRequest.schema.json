{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/demo.stressScenarioRequest.schema.json",
  "type": "object",
  "title": "Stress Scenario Request",
  "description": "Context for `demo.RunStressScenario`.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "demo.stressScenarioRequest" },
        "portfolioId": { "type": "string" },
        "scenario": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "oilPriceShockPct": { "type": "number" },
            "rateShockBps": { "type": "number" }
          },
          "required": ["name"]
        }
      },
      "required": ["type", "portfolioId", "scenario"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ],
  "examples": [
    {
      "type": "demo.stressScenarioRequest",
      "portfolioId": "aipa-energy-demo-1",
      "scenario": { "name": "oil-down-20", "oilPriceShockPct": -20 }
    }
  ]
}
