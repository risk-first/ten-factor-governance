{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/demo.researchBundle.schema.json",
  "type": "object",
  "title": "Research Bundle",
  "description": "Signed research findings. IntentResult of `demo.GetResearch`.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "demo.researchBundle" },
        "subject": {
          "type": "object",
          "properties": {
            "portfolioId": { "type": "string" },
            "tickers": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["tickers"]
        },
        "asOf": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "sourceUrl": { "type": "string" },
              "sourceType": { "type": "string", "enum": ["filing", "news", "fixture"] },
              "publishedAt": { "type": "string" },
              "tickers": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["title", "summary", "sourceUrl", "sourceType", "publishedAt"]
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "bundleId": { "type": "string" },
            "sources": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["bundleId", "sources"]
        }
      },
      "required": ["type", "subject", "asOf", "findings", "provenance"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ]
}
