{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdc3.finos.org/schemas/next/context/ai.agentAnswer.schema.json",
  "type": "object",
  "title": "Agent Answer",
  "description": "Final turn result from the agent harness to the Agent UI on the PrivateChannel: markdown body plus optional citations, artifacts, and follow-up suggestions.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "fdc3.ai.agentAnswer"
        },
        "markdown": {
          "type": "string",
          "title": "Markdown",
          "description": "Final assistant reply as markdown."
        },
        "citations": {
          "type": "array",
          "title": "Citations",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "appInstanceId": { "type": "string" },
              "url": { "type": "string" },
              "title": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "artifacts": {
          "type": "array",
          "title": "Artifacts",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "uuid": { "type": "string" },
              "name": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "suggestions": {
          "type": "array",
          "title": "Suggestions",
          "items": { "type": "string" }
        }
      },
      "required": ["type", "markdown"]
    },
    { "$ref": "context.schema.json#/definitions/BaseContext" }
  ],
  "examples": [
    {
      "type": "fdc3.ai.agentAnswer",
      "markdown": "AAPL revenue grew **8%** YoY vs MSFT **15%**.",
      "citations": [
        {
          "id": "c1",
          "source": "app",
          "appInstanceId": "inst-aapl"
        }
      ],
      "artifacts": [
        {
          "type": "table",
          "uuid": "art-1",
          "name": "Revenue comparison"
        }
      ],
      "suggestions": [
        "Show quarterly breakdown",
        "Add a chart to the dashboard"
      ]
    }
  ]
}
